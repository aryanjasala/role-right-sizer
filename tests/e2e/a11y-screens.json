      "name": "Users > Right-Sizer during the learning period",
      "setup": [
        {
          "js": "seed.js",
          "call": "seed",
          "args": [
            12
          ]
        }
      ],
      "url": "/wp-admin/users.php?page=role-right-sizer",
      "steps": [
        {
          "waitFor": ".rrs-learning"
        }
      ],
      "cleanup": [
        {
          "js": "seed.js",
          "call": "clean"
        }
      ]
    },
